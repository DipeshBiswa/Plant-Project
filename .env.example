# Copy these entries into the project-root .env and replace the placeholders.
# Keep any existing API key. Do not commit real credentials.
# application.properties adds the jdbc: prefix to DB_URL.
DB_URL=postgresql://localhost:5432/plant_p
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
ANTHROPIC_API_KEY=your_anthropic_api_key
